// AGSL - Shader de Atractor de Clifford (Versión Estable/Video)

uniform float u_time;
uniform vec2 u_resolution;

// --- PARÁMETROS (Copiados de tu versión Shadertoy) ---

// 1. ADN (Forma) - Idénticos a los tuyos
const float A_BASE = -1.4;
const float B_BASE = 1.6;
const float C_BASE = 1.0;
const float D_BASE = 0.7;

// 2. VELOCIDAD - Idéntica a tu versión estable
const float A_SPEED = 0.05;
const float B_SPEED = 0.03;
const float C_SPEED = 0.1;
const float D_SPEED = 0.07;

// 3. CALIDAD (LA CLAVE DEL ÉXITO)
// Bajamos de 30 a 20. Esto elimina el "ruido" y lo hace estable.
const int ITERATIONS = 20;

// 4. COLOR
// Tu color rojo oscuro exacto: vec3(0.7, 0.0, 0.0)
const vec3 COLOR = vec3(0.8, 0.0, 0.3);

// -------------------------------------------------------------------
// LÓGICA
// -------------------------------------------------------------------

vec4 main(vec2 fragCoord) {

    // --- PASO 1: COORDENADAS ---
    vec2 p = (fragCoord.xy * 2.0 - u_resolution.xy) / min(u_resolution.x, u_resolution.y);

    // --- PASO 2: ANIMACIÓN ---
    float a = A_BASE + sin(u_time * A_SPEED) * 0.5;
    float b = B_BASE + cos(u_time * B_SPEED) * 0.4;
    float c = C_BASE + sin(u_time * C_SPEED) * 0.2;
    float d = D_BASE + cos(u_time * D_SPEED) * 0.3;

    // --- PASO 3: SIMULACIÓN ---
    for(int i = 0; i < ITERATIONS; i++) {
        p = vec2(
            sin(a * p.y) + c * cos(a * p.x),
            sin(b * p.x) + d * cos(b * p.y)
        );
    }

    // --- PASO 4: COLOREAR ---
    float brightness = smoothstep(0.0, 1.5, length(p));

    // Salida final (Opacidad 1.0 siempre)
    return vec4(COLOR * brightness, 1.0);
}